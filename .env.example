# Modelo de variáveis de ambiente. Copie para .env e preencha com os valores
# reais — este arquivo NUNCA deve conter credencial de verdade (ele é o que se
# versiona/compartilha).

# Postgres (Neon). Pegue a connection string no painel do Neon.
DATABASE_URL="postgresql://usuario:senha@host.neon.tech/banco?sslmode=require"

# Chave de assinatura das sessões (JWT). Mínimo 16 caracteres — gere uma forte:
#   openssl rand -base64 48
AUTH_SECRET="troque-por-uma-chave-aleatoria-longa"

# Conta de administrador criada pelo seed de demonstração (npm run db:seed).
DEMO_ADMIN_EMAIL="rh@exemplo.com.br"
DEMO_ADMIN_PASSWORD="defina-uma-senha-forte"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Opcionais — só para a exportação de relatório em PDF (Playwright/Chromium).
# Deixe em branco para usar o Chromium que o playwright baixa por padrão.
# PLAYWRIGHT_CHROMIUM_PATH=""
# PLAYWRIGHT_BROWSERS_PATH=""

# Web Push (avisos no celular). Gere um par com:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# A chave publica e entregue ao navegador; a privada NUNCA sai do servidor.
# Sem estas variaveis o push fica desligado e o sino continua funcionando.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:rh@restaurantespot.com.br"

# Protege /api/cron/feedback-reminders contra chamadas de terceiros.
# Gere com: openssl rand -base64 32
# A rota exige "Authorization: Bearer <valor>" e recusa (503) se estiver vazio.
CRON_SECRET="troque-por-um-valor-aleatorio-longo"


# Backups cifrados (npm run db:backup). Gere com: node -e "console.log(require('crypto').randomBytes(30).toString('base64url'))"
BACKUP_PASSPHRASE=""
# Opcional: pasta dos backups (padrão Documentos\spot-clima-backups) e quantos manter (padrão 30).
# BACKUP_DIR=""
# BACKUP_KEEP="30"
